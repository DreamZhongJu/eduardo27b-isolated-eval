# Explicit allowlist: never stage data, logs, results, weights or credentials.
/*
!/.gitignore
!/.dockerignore
!/Dockerfile
!/README.md
!/AGENT_GUIDE.md
!/SOURCE_SELECTION.md
!/LICENSE.author
!/app/
/app/*
!/app/*.py
!/agnes_eval_v2/
/agnes_eval_v2/*
!/agnes_eval_v2/*.py
!/agnes_eval_v2/*.sh
!/agnes_eval_v2/README.md
!/parallel_eval_v3/
/parallel_eval_v3/*
!/parallel_eval_v3/*.py
!/parallel_eval_v3/README.md
!/parallel_eval_v4/
/parallel_eval_v4/*
!/parallel_eval_v4/*.py
!/parallel_eval_v4/README.md
!/diagnostics/
/diagnostics/*
!/diagnostics/agnes_unknown_diagnostic.py
!/diagnostics/test_agnes_unknown_diagnostic.py
!/diagnostics/agnes_unknown_shape_probe.py
!/diagnostics/test_agnes_unknown_shape_probe.py
!/diagnostics/agnes_topbool_recovery.py
!/diagnostics/test_agnes_topbool_recovery.py
!/official/
/official/*
!/official/eduardo/
/official/eduardo/*
!/official/eduardo/configs/
/official/eduardo/configs/*
!/official/eduardo/configs/prompts/
/official/eduardo/configs/prompts/*
!/official/eduardo/configs/prompts/*.txt

# These patterns remain forbidden even if a future exception is added above.
**/__pycache__/
*.py[cod]
*.json
*.jsonl
*.parquet
*.safetensors
*.gguf
*.bin
*.pt
*.pth
*.ckpt
*.log
*.key
.env
.env.*
**/results/
**/outputs/
**/data/
**/logs/
**/models/
**/secrets/
